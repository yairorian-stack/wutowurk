function installCashbook_(){assertPrivate_();var c=config_(),ss=book_();if(!sheetById_(ss,c.sourceId))throw new Error('正本のタブが見つかりません');var definitions={};definitions[CB_NAMES_.days]=['営業日','版','送信番号','照合値','初回日時','最終日時','保存したアカウント','担当者','入力JSON','集計JSON','備考'];definitions[CB_NAMES_.audit]=['日時','実行アカウント','営業日','操作','旧版','新版','送信番号','変更前JSON','照合値'];definitions[CB_NAMES_.purchases]=['営業日','番号','購入業者','購入内容','金額','支払方法','Drive写真','備考','担当者','登録日時'];definitions[CB_NAMES_.movements]=['営業日','科目','概要','入金','出金','担当者'];Object.keys(definitions).forEach(function(name){var s=ss.getSheetByName(name);if(s){if(JSON.stringify(s.getRange(1,1,1,definitions[name].length).getValues()[0])!==JSON.stringify(definitions[name]))throw new Error('同名シートの形式が異なります: '+name);return;}s=ss.insertSheet(name);if(s.getMaxRows()<2000)s.insertRowsAfter(s.getMaxRows(),2000-s.getMaxRows());if(s.getMaxColumns()<definitions[name].length)s.insertColumnsAfter(s.getMaxColumns(),definitions[name].length-s.getMaxColumns());s.getRange(1,1,1,definitions[name].length).setValues([definitions[name]]).setBackground('#204f3d').setFontColor('#ffffff').setFontWeight('bold');s.setFrozenRows(1);protectRange_(s.getRange(1,1,s.getMaxRows(),s.getMaxColumns()),'816入力の保存原本');});if(!props_().getProperty('CASHBOOK_RECEIPT_FOLDER')){var folder=DriveApp.createFolder('816_出納帳レシート_非公開');props_().setProperty('CASHBOOK_RECEIPT_FOLDER',folder.getId());}return {ready:true,preview:originalPreview_()};}
