# Server-only configuration. Use a private Supabase project and an HTTPS Next.js host.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key
PORTAL_ORIGIN=https://portal.example.com
# Never put a secret/service-role key in SUPABASE_PUBLISHABLE_KEY.
